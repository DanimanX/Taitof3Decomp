# ROMs & Dumps (STRICTLY PROHIBITED TO COMMIT COPYRIGHTED GAME DATA)
roms/
*.zip
*.7z
*.bin
*.rom

# Python Virtual Environments & Packages
.venv/
tools/*/.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Agent & MCP working directories
.codewhale/
.mame_mcp/
.mcp.json

# Ghidra user data, vector DB & locks
ghidra_proj/**/*.lock*
ghidra_proj/**/chromadb/
ghidra_proj/**/gzfs/
ghidra_proj/**/user/
*.lock
*.lock~

# Dynamic traces and intermediate dumps
traces/*.trace
states/**/*.sta
work/*.bin
work/*.dump

# OS & Editor configurations
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated decompiler output (derived from ROM)
work/decomp/
work/disasm/
build/
.worktrees/

# Ghidra program databases contain ROM bytes: never commit
ghidra_proj/**/idata/
ghidra_proj/**/versioned/

# Raw multi-MB trace logs: commit the *.pcs.tsv summaries instead
traces/mmio/*.log
work/ram/
.codewhale-worktrees/

# Second game: Ghidra DB holds the ROM bytes
elvactr/ghidra_proj/
elvactr/work/ghidra_bootstrap.log
elvactr/work/ram/
elvactr/work/strata_loop.log
